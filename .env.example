# Copy to `.env` (gitignored) and fill in. Loaded by every `probe` command;
# anything already exported in the shell wins over what is set here.
#
# Only needed for `--backend anthropic`. The committed traces, and everything
# `make eval` recomputes from them, come from the offline `sim` backend and
# need no key at all.

ANTHROPIC_API_KEY=sk-ant-...

# Default model for the live backend. Accepts haiku | sonnet | opus or a full
# model id. `--model` overrides it per command.
PROBE_MODEL=haiku
